# ===========================================
# VPS Docker Swarm Configuration
# ===========================================
# Copy to .env and update all values:
#   cp .env.example .env
# ===========================================

# SERVERIO domenas admin įrankiams (traefik.$DOMAIN, prometheus.$DOMAIN ir t.t.) — ne projekto
# domenas: serveris laiko kelis projektus. Prod: cetex.dev (*.cetex.dev wildcard, DNS only).
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Mail domenas — mailserver'io FQDN bus mail.$MAIL_DOMAIN. ATSKIRAS nuo DOMAIN,
# nes DOMAIN paštas gali būti kitur (pvz. pickzy.app ant Google Workspace).
# Mailserver aptarnauja bet kokį domeną, kuriam sukuri dėžutę (žr. mail-manage.sh).
MAIL_DOMAIN=example.com

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_pg_strong_password
POSTGRES_DB=default

# PostgreSQL - servisų duombazės
ROUNDCUBE_DB_PASSWORD=CHANGE_ME_roundcube_db_password
GRAFANA_DB_PASSWORD=CHANGE_ME_grafana_db_password
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME_exporter_password

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# Kas gali pasiekti admin įrankius ORIGIN'e (Traefik `admin-whitelist`). Prod'e — Cloudflare
# intervalai (www.cloudflare.com/ips-v4 + ips-v6): įrankiai už Cloudflare Access, tad visas
# srautas ateina iš Cloudflare. Asmeninis IP čia nieko neduoda. Žr. CLAUDE.md → Admin tools.
ADMIN_WHITELIST_IPS=127.0.0.1/32

# Playwright (browserless) — API token autentifikacijai
PLAYWRIGHT_TOKEN=CHANGE_ME_playwright_token

# Mail (naudoja DOMAIN kintamąjį)
